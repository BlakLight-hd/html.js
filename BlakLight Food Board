<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Voice Food Ordering</title>
  <style>
    * { box-sizing: border-box; }

    body {
      margin: 0;
      font-family: Arial, sans-serif;
      background: #fff; /* default white */
      display: flex;
      justify-content: center;
      align-items: center;
      height: 100vh;
      overflow: hidden;
    }

    .app {
      position: relative;
      width: 900px;
      max-width: 95vw;
      height: 520px;
      border-radius: 22px;
      padding: 15px;
      box-shadow: 0 15px 35px rgba(0,0,0,0.4);
      overflow: hidden;
      color: #000;
      background-size: cover;
      background-position: center;
      background-repeat: no-repeat;
      background-size: cover;
      background-color: #fff; /* default white */
    }

    .header {
      position: relative;
      z-index: 1;
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 10px;
    }

    .header h1 { font-size: 20px; margin: 0; }

    .top-icons { display: flex; gap: 10px; }

    .icon-btn {
      width: 40px;
      height: 40px;
      border-radius: 50%;
      border: none;
      font-size: 20px;
      cursor: pointer;
      background: rgba(0,0,0,0.4);
      color: #fff;
    }

    .container,
    .menu-settings,
    .theme-screen {
      position: relative;
      z-index: 1;
      display: flex;
      height: 430px;
      border-radius: 14px;
      overflow: hidden;
      background: rgba(255,255,255,0.75);
      backdrop-filter: blur(10px);
    }

    .menu-settings,
    .theme-screen { display: none; flex-direction: column; padding: 20px; }

    .left, .right { flex: 1; padding: 20px; }

    .left { border-right: 1px solid rgba(0,0,0,0.1); }

    h3, h4 { margin-top: 0; }

    .box, .speech-box {
      border: 2px dashed rgba(0,0,0,0.3);
      border-radius: 10px;
      min-height: 100px;
      max-height: 160px;
      padding: 10px;
      margin-bottom: 12px;
      overflow-y: auto;
      background: rgba(255,255,255,0.4);
    }

    .box::-webkit-scrollbar,
    .menu-scroll::-webkit-scrollbar { width: 0; height: 0; }

    .total { font-weight: bold; margin-bottom: 10px; }

    ul { list-style: none; padding: 0; margin: 0; font-size: 14px; }

    li { margin-bottom: 6px; display: flex; justify-content: space-between; align-items: center; }

    .menu-item-btn {
      background: none;
      border: none;
      cursor: pointer;
      font-size: 14px;
      text-align: left;
      color: #000;
    }

    .remove-btn {
      background: #ff4d4d;
      border: none;
      color: white;
      border-radius: 6px;
      padding: 3px 8px;
      cursor: pointer;
      font-size: 12px;
    }

    .mic-area { text-align: center; }

    .mic-btn {
      width: 80px;
      height: 80px;
      border-radius: 50%;
      border: none;
      background: radial-gradient(circle, #ff6666, #cc0000);
      cursor: pointer;
      box-shadow: 0 6px 15px rgba(0,0,0,0.4);
      transition: transform 0.2s, box-shadow 0.2s;
    }

    .mic-btn.listening {
      transform: scale(1.15);
      box-shadow: 0 0 25px rgba(255,0,0,0.9);
      animation: pulse 1.2s infinite;
    }

    @keyframes pulse {
      0% { transform: scale(1); }
      50% { transform: scale(1.15); }
      100% { transform: scale(1); }
    }

    .listening-indicator { margin-top: 10px; font-weight: bold; color: #cc0000; display: none; }

    .menu-settings input,
    .theme-screen input {
      width: 100%;
      padding: 8px;
      border-radius: 6px;
      border: 1px solid #ccc;
      margin-bottom: 10px;
    }

    .primary-btn {
      width: 100%;
      padding: 10px;
      border-radius: 8px;
      border: none;
      background: #333;
      color: white;
      font-size: 14px;
      cursor: pointer;
      margin-bottom: 8px;
    }

    .menu-scroll { max-height: 150px; overflow-y: auto; }

  </style>
</head>
<body>

<div id="app" class="app">

  <div class="header">
    <h1>Voice Food Ordering</h1>
    <div class="top-icons">
      <button id="themeBtn" class="icon-btn">🎨</button>
      <button id="menuBtn" class="icon-btn">＋</button>
    </div>
  </div>

  <div id="mainScreen" class="container">
    <div class="left">
      <h3>Your Order</h3>
      <div class="box"><ul id="orderList"></ul></div>
      <div class="total">Total: $<span id="total">0.00</span></div>
      <h4>Menu</h4>
      <div class="menu-scroll"><ul id="menuListMain"></ul></div>
    </div>
    <div class="right">
      <h3>Your speech will appear here</h3>
      <div id="speechBox" class="speech-box"></div>
      <div class="mic-area">
        <button id="micBtn" class="mic-btn"></button>
        <div id="listeningIndicator" class="listening-indicator">Listening...</div>
      </div>
    </div>
  </div>

  <div id="menuSettings" class="menu-settings">
    <h2>Customize Your Menu</h2>
    <input id="itemName" placeholder="Item name" />
    <input id="itemPrice" placeholder="Price (e.g. 5.99)" />
    <button id="addItemBtn" class="primary-btn">Add Item</button>
    <h3>Current Menu</h3>
    <ul id="menuListSettings"></ul>
  </div>

  <div id="themeScreen" class="theme-screen">
    <h2>Theme Background</h2>
    <p>Upload an image to use as the app background.</p>
    <input id="bgInput" type="file" accept="image/*" />
  </div>

</div>

<script>
const app = document.getElementById("app");
const mainScreen = document.getElementById("mainScreen");
const menuSettings = document.getElementById("menuSettings");
const themeScreen = document.getElementById("themeScreen");

const menuListMain = document.getElementById("menuListMain");
const menuListSettings = document.getElementById("menuListSettings");
const orderList = document.getElementById("orderList");
const totalSpan = document.getElementById("total");

const menuBtn = document.getElementById("menuBtn");
const themeBtn = document.getElementById("themeBtn");
const micBtn = document.getElementById("micBtn");
const listeningIndicator = document.getElementById("listeningIndicator");
const speechBox = document.getElementById("speechBox");
const bgInput = document.getElementById("bgInput");

let menu = { pizza: 5.0, burger: 4.0, shake: 3.5, fries: 2.5, cookie: 1.5 };
let order = [];
let history = [];

menuBtn.onclick = () => {
  const showMain = mainScreen.style.display === "none";
  mainScreen.style.display = showMain ? "flex" : "none";
  menuSettings.style.display = showMain ? "none" : "block";
  themeScreen.style.display = "none";
  updateMenuLists();
};

themeBtn.onclick = () => {
  const showTheme = themeScreen.style.display !== "block";
  themeScreen.style.display = showTheme ? "block" : "none";
  mainScreen.style.display = showTheme ? "none" : "flex";
  menuSettings.style.display = "none";
};

function updateMenuLists() {
  menuListMain.innerHTML = "";
  menuListSettings.innerHTML = "";

  for (const item in menu) {
    const liMain = document.createElement("li");
    const btn = document.createElement("button");

    btn.className = "menu-item-btn";
    btn.textContent = `${item} - $${menu[item].toFixed(2)}`;
    btn.onclick = () => addToOrder(item, 1);

    liMain.appendChild(btn);
    menuListMain.appendChild(liMain);

    const liSet = document.createElement("li");
    const span = document.createElement("span");
    const removeBtn = document.createElement("button");

    span.textContent = `${item} - $${menu[item].toFixed(2)}`;

    removeBtn.className = "remove-btn";
    removeBtn.textContent = "Remove";
    removeBtn.onclick = () => {
      delete menu[item];
      updateMenuLists();
      updateOrder();
    };

    liSet.appendChild(span);
    liSet.appendChild(removeBtn);
    menuListSettings.appendChild(liSet);
  }
}

function addToOrder(item, qty) {
  history.push([...order]);
  for (let i = 0; i < qty; i++) order.push(item);
  updateOrder();
}

function removeFromOrder(item, qty) {
  history.push([...order]);
  for (let i = 0; i < qty; i++) {
    const idx = order.indexOf(item);
    if (idx !== -1) order.splice(idx, 1);
  }
  updateOrder();
}

function clearOrder() {
  history.push([...order]);
  order = [];
  updateOrder();
}

function undo() {
  if (history.length > 0) {
    order = history.pop();
    updateOrder();
  }
}

function updateOrder() {
  orderList.innerHTML = "";

  const counts = {};
  order.forEach(item => counts[item] = (counts[item] || 0) + 1);

  let total = 0;

  for (const item in counts) {
    const li = document.createElement("li");
    const span = document.createElement("span");
    const btn = document.createElement("button");

    span.textContent = `${counts[item]} x ${item} - $${(menu[item] * counts[item]).toFixed(2)}`;

    btn.className = "remove-btn";
    btn.textContent = "Remove";
    btn.onclick = () => removeFromOrder(item, 1);

    li.appendChild(span);
    li.appendChild(btn);
    orderList.appendChild(li);

    total += menu[item] * counts[item];
  }

  totalSpan.textContent = total.toFixed(2);
}

bgInput.onchange = () => {
  const file = bgInput.files[0];
  if (!file) return;

  const reader = new FileReader();
  reader.onload = e => {
    app.style.backgroundImage = `url('${e.target.result}')`;
    app.style.backgroundRepeat = 'no-repeat';
    app.style.backgroundSize = 'cover';
  };
  reader.readAsDataURL(file);
};

let recognition = null;
let cooldownTimer = null;

function initVoice() {
  const SR = window.SpeechRecognition || window.webkitSpeechRecognition;
  if (!SR) return;

  recognition = new SR();
  recognition.lang = "en-US";
  recognition.interimResults = true;

  recognition.onstart = () => {
    micBtn.classList.add("listening");
    listeningIndicator.style.display = "block";
  };

  recognition.onend = () => {
    micBtn.classList.remove("listening");
    listeningIndicator.style.display = "none";
  };

  recognition.onresult = event => {
    let interim = "";
    let finalText = "";

    for (let i = event.resultIndex; i < event.results.length; i++) {
      if (event.results[i].isFinal) finalText += event.results[i][0].transcript;
      else interim += event.results[i][0].transcript;
    }

    const combined = (finalText + interim).toLowerCase();
    speechBox.textContent = combined;

    if (finalText) {
      if (cooldownTimer) clearTimeout(cooldownTimer);
      cooldownTimer = setTimeout(() => processSpeech(finalText.toLowerCase()), 1500);
    }
  };
}

function parseNumber(words) {
  const map = { one:1, two:2, three:3, four:4, five:5, six:6, seven:7, eight:8, nine:9, ten:10,
                eleven:11, twelve:12, thirteen:13, fourteen:14, fifteen:15, sixteen:16, seventeen:17,
                eighteen:18, nineteen:19, twenty:20 };

  for (const w of words) {
    if (!isNaN(parseInt(w))) return parseInt(w);
    if (map[w]) return map[w];
  }

  return 1;
}

function processSpeech(text) {
  const words = text.split(/\s+/);

  if (text.includes("clear order")) {
    clearOrder();
    speechBox.textContent += "\n(Order cleared)";
    return;
  }

  if (text.includes("undo")) {
    undo();
    speechBox.textContent += "\n(Undo)";
    return;
  }

  const qty = parseNumber(words);
  const removeMode = text.includes("remove") || text.includes("delete") || text.includes("cancel");

  let matched = false;

  for (const item in menu) {
    const singular = item;
    const plural = item + "s";

    if (text.includes(singular) || text.includes(plural)) {
      matched = true;

      if (removeMode) removeFromOrder(item, qty);
      else addToOrder(item, qty);

      speechBox.textContent += `\n(${removeMode ? "Removed" : "Added"} ${qty} ${item})`;
    }
  }

  if (!matched) speechBox.textContent += "\n(No menu items recognized)";
}

micBtn.onclick = () => {
  if (!recognition) initVoice();
  if (recognition) recognition.start();
};

updateMenuLists();
updateOrder();

</script>
</body>
</html>
